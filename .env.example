# Copy this file to .env and fill in real values.
# Never commit .env or any file containing real credentials.

# Backend REST + Socket.IO base URL
NEXT_PUBLIC_API_URL=http://localhost:5000/

# Supabase (authentication)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Amazon Chime voice/video credential endpoint
NEXT_PUBLIC_CHIME_API_URL=

# GIF picker (Giphy)
NEXT_PUBLIC_GIPHY_API_KEY=

# Optional: Socket.IO path / credentialed requests
NEXT_PUBLIC_SOCKET_PATH=
NEXT_PUBLIC_SOCKET_WITH_CREDENTIALS=

# Optional: Android APK download URL shown on the landing page
NEXT_PUBLIC_APK_URL=
